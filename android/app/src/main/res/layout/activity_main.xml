<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- Mode chip background -->
    <View
        android:id="@+id/header_curve"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_header_curve"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dropdown arrow -->
    <ImageView
        android:id="@+id/iconChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="14dp"
        android:src="@drawable/ic_chevron_down"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@id/header_curve"
        app:layout_constraintTop_toTopOf="@id/header_curve"
        app:layout_constraintBottom_toBottomOf="@id/header_curve" />

    <!-- Mode selector (on top, receives the taps) -->
    <Spinner
        android:id="@+id/spinnerProtocol"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:theme="@android:style/ThemeOverlay.Material.Dark"
        android:entries="@array/protocol_items"
        android:background="@null"
        android:popupBackground="@drawable/bg_spinner_popup"
        android:dropDownVerticalOffset="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="38dp"
        app:layout_constraintStart_toStartOf="@id/header_curve"
        app:layout_constraintEnd_toEndOf="@id/header_curve"
        app:layout_constraintTop_toTopOf="@id/header_curve"
        app:layout_constraintBottom_toBottomOf="@id/header_curve" />

    <!-- Avatar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_icon" />
    </androidx.cardview.widget.CardView>

    <!-- Name + status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/cardAvatar"
        app:layout_constraintEnd_toStartOf="@id/header_curve"
        app:layout_constraintTop_toTopOf="@id/cardAvatar"
        app:layout_constraintBottom_toBottomOf="@id/cardAvatar">

        <EditText
            android:id="@+id/editParams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:text="User Name"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Online"
            android:textColor="#8A8A8A"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Divider under header -->
    <View
        android:id="@+id/divider_header"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#1C1C1C"
        app:layout_constraintTop_toBottomOf="@id/cardAvatar" />

    <!-- Chat list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/divider_header"
        app:layout_constraintBottom_toTopOf="@id/layoutListening" />

    <!-- Debug log -->
    <TextView
        android:id="@+id/textLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#8A8A8A"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/layoutListening" />

    <!-- Listening indicator -->
    <LinearLayout
        android:id="@+id/layoutListening"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@id/layoutInput">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_wave"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Listening for sound"
            android:textColor="#3DDCFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Input area -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="bottom"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <EditText
                android:id="@+id/editMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Type a message"
                android:textColorHint="#8A8A8A"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <Space android:layout_width="10dp" android:layout_height="wrap_content" />

        <!-- Send button -->
        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="#3DDCFF"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send_arrow"
                android:contentDescription="Send message"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
