<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- HEADER SECTION -->
    
    <!-- 1. White Top-Right Curve (Smaller: 130dp x 70dp) -->
    <View
        android:id="@+id/header_curve"
        android:layout_width="130dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_header_curve"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Spinner inside the White Curve (Arrow REMOVED) -->
    <Spinner
        android:id="@+id/spinnerProtocol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:entries="@array/protocol_items"
        android:background="@null"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/header_curve" />

    <!-- 3. Top-Left Content (On Purple BG) -->
    <!-- Back Arrow REMOVED -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#CCCCCC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_icon" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/cardAvatar"
        app:layout_constraintEnd_toStartOf="@id/header_curve"
        app:layout_constraintTop_toTopOf="@id/cardAvatar"
        app:layout_constraintBottom_toBottomOf="@id/cardAvatar">

        <EditText
            android:id="@+id/editParams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:text="User Name"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Online"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- CHAT LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header_curve"
        app:layout_constraintBottom_toTopOf="@id/layoutInput" />

    <!-- DEBUG LOG -->
    <TextView
        android:id="@+id/textLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/layoutInput" />

    <!-- INPUT AREA -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Input Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Mic Button REMOVED -->
            
            <EditText
                android:id="@+id/editMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:layout_marginStart="10dp"
                android:hint="Ok. Let me check"
                android:textColor="@android:color/black"
                android:textSize="16sp" />
        </LinearLayout>

        <Space android:layout_width="12dp" android:layout_height="wrap_content" />

        <!-- Send Button -->
        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="4dp">
            
            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#5E5CE6"
                android:rotation="-30" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
